# Nominal neutral-pion mass in MeV, used for two-body kinematics.
pi0_mass = 134.9768

# Accepted two-photon invariant-mass interval in MeV.
# The boundaries themselves are excluded, as in TA2Pi0Compton.
pi0_mass_min = 5.0
pi0_mass_max = 250.0

# taggedTime - pi0Time windows in ns. Boundaries are included.
#pi0_prompt_min = -35.0
#pi0_prompt_max = 15.0
